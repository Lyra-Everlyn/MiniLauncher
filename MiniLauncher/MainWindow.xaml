<Window x:Class="MiniWorldLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniLauncher"
        Height="540"
        Width="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icons/icon.ico">

    <Border CornerRadius="8" Background="#1E1E1E">
        <Border.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Width="960"
                        Height="540"
                        Background="White"
                        CornerRadius="8"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.OpacityMask>
        
        <Grid>

            <!-- BACKGROUND -->
            <!--
            <MediaElement
                Source="/Assets/Videos/ten_video_cua_ban.mp4"
                Stretch="UniformToFill"
                LoadedBehavior="Play"
                IsMuted="True"/>
            -->

            <Image Source="/Assets/Backgrounds/bg_miniworld_lobby_main.jpg"
                   Stretch="UniformToFill"/>

            <!-- TOP BAR -->
            <Grid Height="35"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- MINIMIZE -->
                    <Button Content="—"
                            Width="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="Minimize_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#33FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- CLOSE -->
                    <Button Content="✕"
                            Width="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Click="Close_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- BOTTOM CONTROLS -->
            <Grid VerticalAlignment="Bottom"
                  Margin="40"
                  Height="60">

                <!-- API ID -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Height="42"
                        Background="#B522173D"
                        CornerRadius="6">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,10,0">

                        <TextBlock Text="API ID"
                                   Foreground="#F0F0F0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <ComboBox x:Name="ApiIdComboBox"
                                  Width="76"
                                  Height="32"
                                  SelectedIndex="0"
                                  Foreground="White"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Cursor="Hand"
                                  VerticalContentAlignment="Center">

                            <ComboBox.Resources>

                                <!-- DROPDOWN ITEM STYLE -->
                                <Style TargetType="ComboBoxItem">

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                    <Setter Property="Background"
                                            Value="Transparent"/>

                                    <Setter Property="Padding"
                                            Value="10,7"/>

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">

                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Margin="3,2">

                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}"/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <!-- HOVER -->
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="ItemBorder"
                                                                Property="Background"
                                                                Value="#554D367B"/>
                                                    </Trigger>

                                                    <!-- SELECTED -->
                                                    <Trigger Property="IsSelected"
                                                             Value="True">
                                                        <Setter TargetName="ItemBorder"
                                                                Property="Background"
                                                                Value="#775F4398"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                </Style>
                            </ComboBox.Resources>

                            <!-- COMBOBOX TEMPLATE -->
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">

                                    <Grid>

                                        <!-- BACKGROUND -->
                                        <Border x:Name="ComboBackground"
                                                Background="#44351E58"
                                                CornerRadius="4"/>

                                        <!-- SELECTED VALUE -->
                                        <ContentPresenter
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,0,15,0"
                                            IsHitTestVisible="False"/>

                                        <!-- ARROW -->
                                        <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                              Fill="White"
                                              Width="10"
                                              Height="5"
                                              Stretch="Fill"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              IsHitTestVisible="False"/>

                                        <!-- TOGGLE -->
                                        <ToggleButton
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            IsChecked="{Binding IsDropDownOpen,
                                                Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">

                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>

                                        </ToggleButton>

                                        <!-- DROPDOWN -->
                                        <Popup Name="PART_Popup"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade">

                                            <Border Background="#302044"
                                                    CornerRadius="5"
                                                    Margin="0,5,0,0"
                                                    MinWidth="76"
                                                    Padding="2">

                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                            </Border>
                                        </Popup>

                                    </Grid>

                                </ControlTemplate>
                            </ComboBox.Template>

                            <!-- API OPTIONS -->
                            <ComboBoxItem Content="410"/>
                            <ComboBoxItem Content="999"/>

                        </ComboBox>

                    </StackPanel>
                </Border>

                <!-- START BUTTON -->
                <Button x:Name="LaunchButton"
                        Content="START"
                        HorizontalAlignment="Right"
                        Width="200"
                        Height="60"
                        FontSize="25"
                        FontFamily="Segoe UI"
                        FontWeight="SemiBold"
                        Foreground="#76651C"
                        Background="#FFD700"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LaunchButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="StartBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- HOVER -->
                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="StartBorder"
                                            Property="Background"
                                            Value="#FFE44D"/>

                                </Trigger>

                                <!-- PRESSED -->
                                <Trigger Property="IsPressed"
                                         Value="True">

                                    <Setter TargetName="StartBorder"
                                            Property="Background"
                                            Value="#E6BA00"/>

                                </Trigger>

                                <!-- DISABLED -->
                                <Trigger Property="IsEnabled"
                                         Value="False">

                                    <Setter TargetName="StartBorder"
                                            Property="Opacity"
                                            Value="0.5"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

        </Grid>
    </Border>

</Window>
